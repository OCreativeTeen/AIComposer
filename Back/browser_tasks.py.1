import sys
import time
from playwright.sync_api import sync_playwright

def handle_gemini(prompt_text):
    """接管 Chrome 打开 Gemini，粘贴 Prompt 并获取输出 JSON"""
    with sync_playwright() as p:
        # 连接或启动 Chrome，指定 User Data 目录以保持登录状态
        browser = p.chromium.launch(headless=False)
        context = browser.new_context()
        page = context.new_page()
        
        page.goto("https://gemini.google.com/")
        page.wait_for_selector("div[contenteditable='true']", timeout=15000)
        
        # 粘贴 Prompt 并发送
        page.fill("div[contenteditable='true']", prompt_text)
        page.keyboard.press("Enter")
        
        # 等待生成完成（简单演示等待，可根据实际页面元素优化）
        time.sleep(15)
        
        # 获取回复文本
        responses = page.query_selector_all(".model-response-text")
        result = responses[-1].inner_text() if responses else ""
        
        browser.close()
        return result

if __name__ == "__main__":
    action = sys.argv[1]
    if action == "gemini":
        prompt = sys.argv[2]
        print(handle_gemini(prompt))