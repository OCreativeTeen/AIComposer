# AIComposer 本地配置示例。复制为 .env 后填写；.env 已在 .gitignore 里，不要提交。
# 带 <...> 的是机密，必须自己填；其余注释掉的行是代码里的当前默认值，需要时去掉 # 再改。

# ---------- API keys（机密）----------
GOOGLE_API_KEY=<your-google-api-key>
# nano_banana.json（ComfyUI 工作流）用的 key，需要时手工填到 ComfyUI 里
GOOGLE_API_KEY_NANO_BANANA=<your-google-api-key>
STRATA_API_KEY=<your-strata-api-key>
DEEPSEEK_API_KEY=<optional>
# MINIMAX_KEY=<optional>
# MINIMAX_GROUP_ID=<optional>
# HF_TOKEN=<optional, whisperx diarization>

# ---------- Telegram（机密）----------
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_CHAT_ID=<chat-id>
# TELEGRAM_CHAT_IDS=<id1,id2>
TELEGRAM_CLI_BOT_TOKEN=<cli-bot-token>
# TELEGRAM_CLI_CHAT_ID=<chat-id>
# TELEGRAM_CLI_BOT_NAME=<bot-name>

# ---------- 媒体根目录 ----------
# Windows 默认 D:/AI_MEDIA；下面有 working/ program/ avatar/ aiagent/ publish/ font/ ...
# AI_MEDIA_ROOT=D:/AI_MEDIA

# ---------- 服务地址（service endpoints）----------
# STRATA_BASE_URL=http://192.168.1.185:8080/v1
# VOICEBOX_BASE_URL=http://192.168.1.36:17493
# VOICEBOX_PROFILE_ID=<voicebox-profile-uuid>
# 以下用于已停用（DEPRECATED）的 sd_image_processor 功能；10.0.0.x 是占位地址
# COMFYUI_URL=http://10.0.0.x:8188
# SD_WEBUI_URL=http://10.0.0.x:7860
# COMFYUI_WORKFLOW_DIR=\\10.0.0.179\wan22\ComfyUI\user\default\workflows
# WAN_I2V_URL=http://10.0.0.231:9001
# WAN_S2V_URL=http://10.0.0.222:9001
# INTERP_URL=http://10.0.0.235:9001
# ENHANCE_SERVERS=http://10.0.0.235:5000
# ENHANCE_API_URL=
# 收尾扫描的视频输出目录，分号分隔
# WAN_OUTPUT_DIRS=X:\output;W:\wan_video\output_mp4

# ---------- NotebookLM ----------
# CLI自动 用的笔记本地址（项目配置 notebooklm_studio_url 可覆盖）
NOTEBOOKLM_STUDIO_URL=https://notebook.google.com/notebook/<notebook-id>
# NOTEBOOKLM_CDP_PORT=9222

# ---------- Gemini ----------
# 对话里自动选的模型（模型按钮菜单里的名字）
# GEMINI_MODEL=3.8 Flash

# ---------- Chrome / CDP ----------
# 账号列表：JSON，label 是显示名（通常是邮箱），directory 是 Chrome profile 目录名
CHROME_PROFILES_JSON='[{"label": "account1@example.com", "directory": "Default"}, {"label": "account2@example.com", "directory": "Profile 1"}]'
# Grok Imagine 用 CHROME_PROFILES_JSON 里的第几个（从 1 起，逗号分隔）
# GROK_IMAGINE_PROFILE_INDICES=1
# GEMINI_CHROME_PROFILE_DIRECTORY=
# GROK_CDP_PORT=9222
# CHROME_EXE=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_CDP_USER_DATA_DIR=%LOCALAPPDATA%\HermesChromeCDP
# CHROME_REMOTE_DEBUGGING_PORT=9222
# HERMES_CDP_URL=http://127.0.0.1:9222
# HERMES_CHROME_PROFILE=
# HERMES_CHROME_USER_DATA_DIR=
# HERMES_BROWSER_CHANNEL=chrome
# HERMES_KEEP_BROWSER=1

# ---------- YouTube 上传 ----------
# config/ 下的 OAuth client_secret 文件名（client_secret*.json 不进 git）
YT_CLIENT_SECRET_CREATIVE4TEEN=config/client_secret_main.json
YT_CLIENT_SECRET_OCREATIVETEEN=config/client_secret_main.json

# YouTube 下载工具（utility/youtube_download.py）：可选 cookies.txt（Netscape 格式）。
# 不设就用 Windows「下载」文件夹里最新的 *cookies*.txt；公开视频通常不需要。
# YOUTUBE_COOKIES_FILE=C:/Users/<you>/Downloads/www.youtube.com_cookies.txt
